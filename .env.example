# Template for local configuration: cp .env.example .env
# .env is git-ignored; never commit real secrets.
# Plain KEY=value lines only: the Makefile sources this file with sh.
# Every variable is described in README.md (Configuration).

# dev (text logs) or prod (JSON logs).
APP_ENV=dev

# debug, info, warn or error.
LOG_LEVEL=info

# Public REST API listen address.
# On Windows, 127.0.0.1:8080 avoids the firewall prompt for local runs.
HTTP_ADDR=:8080

# How long in-flight requests may take to finish after SIGTERM.
# Must be lower than the container stop grace period (30s).
SHUTDOWN_TIMEOUT=25s

# PostgreSQL connection URL (contains the password: never log or commit it).
# Matches the local database from docker-compose.yml (`make up`).
# 127.0.0.1 rather than localhost: on Windows localhost resolves to ::1 first,
# where nothing listens, and every connection waits ~2 s before falling back.
DATABASE_URL=postgres://uptime:uptime@127.0.0.1:5432/uptime?sslmode=disable

# Maximum connections in the pool of one api process.
DB_MAX_CONNS=10
